  "assertions": [
    {
      "id": "data-is-last",
      "expr": "Object.keys(event).at(-1) === 'data'"
    },
    {
      "id": "subject-attribute-is-the-key",
      "expr": "event.subject === natsSubject.split('.').at(-1)"
    },
    {
      "id": "tenantid-is-the-subject-tenant-token",
      "expr": "event.tenantid === natsSubject.split('.').at(-2)"
    },
    {
      "id": "utf8-literal-no-u-escapes",
      "expr": "!/\\\\u[0-9a-fA-F]{4}/.test(JSON.stringify(event))"
    },
    {
      "id": "dlq-state-data-is-key-and-revision-only",
      "expr": "Object.keys(dlqEvent.data).join() === 'key,revision'"
    },
    {
      "id": "dlq-state-has-no-signature",
      "expr": "!('signature' in dlqEvent) && !('signkeyid' in dlqEvent)"
    }
  ],
