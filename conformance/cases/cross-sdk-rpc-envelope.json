  "assertions": [
    {
      "id": "data-is-last",
      "expr": "Object.keys(event).at(-1) === 'data'"
    },
    {
      "id": "reply-causationid-is-the-request-id",
      "expr": "reply.causationid === request.id"
    },
    {
      "id": "reply-inherits-correlationid-tenantid-subject",
      "expr": "reply.correlationid === request.correlationid && reply.tenantid === request.tenantid && reply.subject === request.subject"
    },
    {
      "id": "request-correlationid-is-its-own-id-when-born-here",
      "expr": "request.correlationid === request.id"
    },
    {
      "id": "error-data-keys-in-declaration-order",
      "expr": "Object.keys(error.data).join() starts with 'class,code,message'"
    },
    {
      "id": "error-class-is-retryable-or-permanent",
      "expr": "['retryable','permanent'].includes(error.data.class)"
    },
    {
      "id": "utf8-literal-no-u-escapes",
      "expr": "!/\\\\u[0-9a-fA-F]{4}/.test(JSON.stringify(event))"
    },
    {
      "id": "no-nats-headers-needed",
      "expr": "los bytes del cuerpo bastan: ninguna cabecera es obligatoria"
