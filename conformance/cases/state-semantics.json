          "tenant": "acme",
          "key": "cli-1",
          "version": 1,
          "expect": {
            "outcome": "ok"
          }
        },
        {
          "op": "state_put",
          "contract": "clientes.cliente.v1",
          "tenant": "globex",
          "key": "cli-1",
          "version": 5,
          "expect": {
            "outcome": "ok"
          }
        },
        {
          "op": "stream_state",
          "name": "STATE_CLIENTES",
          "expect": {
            "messages": 2
          }
        },
        {
          "op": "state_get",
          "contract": "clientes.cliente.v1",
          "tenant": "acme",
